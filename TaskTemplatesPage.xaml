<Page
    x:Class="FluentTaskScheduler.TaskTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:FluentTaskScheduler.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid>
        <ScrollViewer x:Name="PageScrollViewer" Padding="24" IsScrollInertiaEnabled="False">
            <StackPanel Spacing="20" MaxWidth="1400" HorizontalAlignment="Left">

                <StackPanel Spacing="6">
                    <TextBlock x:Name="TemplatesTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="TemplatesSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>

                <InfoBar x:Name="TemplatesInfoBar" IsOpen="True" IsClosable="True" Severity="Informational"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TaskTemplateGroup">
                            <StackPanel Spacing="10" Margin="0,0,0,24">
                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                <GridView ItemsSource="{x:Bind Templates}" SelectionMode="None" Padding="0">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:TaskTemplateCard">
                                            <Grid Width="340" MinHeight="216" Margin="0,0,12,12" Padding="16"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                  CornerRadius="8" BorderThickness="1"
                                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Opacity="0.75" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" Width="250"/>
                                                    <FontIcon Glyph="&#xE7EF;" FontSize="12" Opacity="0.7" VerticalAlignment="Top"
                                                              Visibility="{x:Bind AdminVisibility}"
                                                              ToolTipService.ToolTip="Requires administrator privileges"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" Margin="0,10,0,0"/>

                                                <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,10">
                                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Opacity="0.55" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind NoteVisibility}">
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="11"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                   TextWrapping="Wrap" Width="280"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Row="3" HorizontalAlignment="Stretch" Click="DeployTemplate_Click"
                                                        Tag="{x:Bind Template}" Style="{StaticResource AccentButtonStyle}"
                                                        Content="{x:Bind DeployLabel}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
